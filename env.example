# Local development only. Copy to .env and choose your own password.
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql://dima_local:replace_with_local_password@127.0.0.1:5432/dima
PORT=3000
# Hosted synthetic testing only: use Render secret settings, never commit values.
# DIMA_HOSTED_DEMO=true
# NODE_ENV=staging
# DEMO_PASSWORD=choose_at_least_16_random_characters
# Separate empty disposable database used only by optional integration tests:
# TEST_DATABASE_URL=postgresql://dima_local:password@127.0.0.1:5432/dima_test
