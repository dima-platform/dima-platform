  "components": {
    "securitySchemes": {
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque accessToken from /v1/auth/verify. Fixed demo tokens are rejected."
      }
    },
    "responses": {
      "Error": {
        "description": "Error; see API.md for status semantics",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Status": {
        "type": "string",
        "enum": [
          "placed",
          "accepted",
          "preparing",
          "ready",
          "assigned",
          "picked_up",
          "delivered",
          "cancelled"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "required": [
          "storeId",
          "addressId",
          "addressVersion",
          "quoteTotalMilli",
          "items"
        ],
        "properties": {
          "storeId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity"
              ],
              "properties": {
                "productId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            }
          },
          "quoteTotalMilli": {
            "type": "integer",
            "minimum": 0,
            "description": "Total shown to customer in millimes. Mismatch returns 409 before creating order."
          },
          "addressId": {
            "type": "string"
          },
          "addressVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string"
          },
          "storeId": {
            "type": "string"
          },
          "courierId": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": "string"
          },
          "totalMilli": {
            "type": "integer",
            "minimum": 0
          },
          "deliveryMilli": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "const": "TND"
          },
          "payment": {
            "const": "cash_on_delivery"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "nameFr": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "priceMilli": {
                  "type": "integer"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "addressSnapshot": {
            "type": "object",
            "description": "Immutable saved-address and service-zone snapshot"
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer"
          },
          "refreshExpiresIn": {
            "type": "integer"
          },
          "actor": {
            "type": "object"
          },
          "mode": {
            "const": "synthetic-demo"
          }
        }
      }
    }
  }
}
